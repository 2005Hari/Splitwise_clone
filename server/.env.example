# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=4000
NODE_ENV=development
# Where the React app is served from, for CORS and for building settlement returnUrl
CLIENT_ORIGIN=http://localhost:5173

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Database ---
SQLITE_DB_PATH=./data/splitwise.sqlite

# --- YouPI-PG (self-hosted payment gateway: https://github.com/youpi-pg/YouPI-PG) ---
# Base URL of YOUR OWN running YouPI-PG payment-api (BASE_PAYMENT_API_URL in its .env).
# Local dev default when you run YouPI-PG yourself: http://localhost:6100
YOUPI_API_URL=http://localhost:6100
# The merchant UUID YouPI-PG's merchant-admin dashboard gave you (X-Merchant-Id).
YOUPI_MERCHANT_ID=
# The webhook signing secret shown next to that merchant in merchant-admin.
# Used to verify X-Gateway-Signature on inbound webhooks. Keep this on the server only.
YOUPI_WEBHOOK_SECRET=
# The checkout portal host that serves youpi.js and the hosted checkout UI
# (BASE_CHECKOUT_URL in YouPI-PG's .env, e.g. http://localhost:7000). Sent to the
# client so it can load the in-app checkout script; not secret.
YOUPI_CHECKOUT_HOST=http://localhost:7000

# --- Receipt uploads ---
# Local disk folder receipts are saved to. No S3/cloud storage account needed.
UPLOAD_DIR=./data/uploads

# --- Web Push notifications (browser notifications, no third-party account) ---
# Optional: leave blank and a keypair is generated on first boot and cached to
# data/vapid-keys.json. Set these to keep the SAME keypair across redeploys —
# changing it invalidates every existing subscription.
# Generate with: node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Email (optional) ---
# Any SMTP provider works — your own mail server, or a provider's SMTP
# endpoint (Resend, Postmark, SES, etc.). Leave blank to disable email: it
# no-ops (logs instead of sending) rather than erroring.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Splitwise Clone <no-reply@example.com>"
